---
// Últimas publicaciones de @marcayempresa.
// Los datos los trae scripts/instagram.mjs en cada build (GitHub Actions, una vez al día).
// Las imágenes quedan en el propio sitio: no se carga nada de Instagram al visitar la página.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import datos from '../data/instagram.json';
import { SITE } from '../config/site';

interface Post { id: string; tipo: string; enlace: string; texto: string; fecha: string; imagen: string }

const imagenes = import.meta.glob<{ default: ImageMetadata }>('../assets/instagram/*.{jpg,jpeg,png,webp}', { eager: true });
const porNombre = Object.fromEntries(
  Object.entries(imagenes).map(([ruta, mod]) => [ruta.split('/').pop(), mod.default]),
);

const posts = (datos.posts as Post[])
  .map((p) => ({ ...p, img: porNombre[p.imagen] }))
  .filter((p) => p.img)
  .slice(0, 6);
// La cuadrícula es de 3 columnas: con 4 o 5 publicaciones se muestran 3 para que no quede un hueco.
const visibles = posts.length >= 6 ? posts : posts.slice(0, Math.min(posts.length, 3));

const resumen = (t: string) => {
  const limpio = t.replace(/#[\p{L}\d_]+/gu, '').replace(/\s+/g, ' ').trim();
  return limpio.length > 110 ? limpio.slice(0, 107).trimEnd() + '…' : limpio;
};
const fecha = (iso: string) =>
  new Date(iso).toLocaleDateString('es-CO', { day: 'numeric', month: 'short', timeZone: 'America/Bogota' });
---
<section class="sec ig" aria-labelledby="ig-titulo">
  <div class="wrap">
    <div class="ig__cabeza">
      <div>
        <p class="etiqueta">En Instagram</p>
        <h2 id="ig-titulo">Ideas cortas para <em>tu marca y tu empresa</em></h2>
        <p class="destacado">Publicamos consejos prácticos y respuestas a dudas frecuentes en {SITE.instagramUsuario}.</p>
      </div>
      <a class="btn btn--borde" href={SITE.instagram} target="_blank" rel="noopener"
         data-evento="instagram_click" data-ubicacion="home-seguir">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        Seguir en Instagram
      </a>
    </div>

    {visibles.length > 0 && (
      <ul class="ig__grid">
        {visibles.map((p) => (
          <li>
            <a class="ig__post" href={p.enlace} target="_blank" rel="noopener"
               data-evento="instagram_click" data-ubicacion="home-publicacion">
              <Image src={p.img} alt={resumen(p.texto) || `Publicación de ${SITE.instagramUsuario}`}
                     widths={[240, 360, 480]} sizes="(min-width: 960px) 360px, 45vw" loading="lazy" />
              {p.tipo !== 'IMAGE' && (
                <span class="ig__tipo" aria-hidden="true">
                  {p.tipo === 'VIDEO'
                    ? <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    : <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="7" width="13" height="13" rx="2"/><path d="M4 16V5a1 1 0 0 1 1-1h11"/></svg>}
                </span>
              )}
              <span class="ig__texto">
                <span>{resumen(p.texto)}</span>
                <small>{fecha(p.fecha)} · Ver en Instagram →</small>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .ig__cabeza { display: grid; gap: 20px; align-items: end; margin-bottom: 32px; }
  @media (min-width: 900px) { .ig__cabeza { grid-template-columns: 1fr auto; gap: 40px; margin-bottom: 40px; } }
  .ig__cabeza h2 { margin-bottom: 10px; }
  .ig__grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  @media (min-width: 700px) { .ig__grid { grid-template-columns: repeat(3, 1fr); gap: 16px; } }
  /* En móvil (2 columnas) la tercera de tres quedaría sola: se oculta. */
  @media (max-width: 699px) { .ig__grid li:nth-child(3):last-child { display: none; } }
  .ig__post {
    position: relative; display: block; aspect-ratio: 1; overflow: hidden;
    border-radius: var(--radio); background: var(--papel-sombra); color: var(--blanco); text-decoration: none;
  }
  .ig__post :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
  .ig__tipo {
    position: absolute; top: 10px; right: 10px; display: grid; place-items: center;
    width: 30px; height: 30px; border-radius: 50%; background: rgba(0, 40, 112, 0.72);
  }
  .ig__texto {
    position: absolute; inset: auto 0 0 0; display: grid; gap: 6px; padding: 40px 14px 14px;
    background: linear-gradient(to top, rgba(0, 40, 112, 0.92), rgba(0, 40, 112, 0));
    font-size: 14px; line-height: 1.4; opacity: 0; transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .ig__texto span { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ig__texto small { color: var(--hielo); font-size: 12px; font-weight: 600; }
  .ig__post:hover :global(img), .ig__post:focus-visible :global(img) { transform: scale(1.04); }
  .ig__post:hover .ig__texto, .ig__post:focus-visible .ig__texto { opacity: 1; transform: none; }
  @media (hover: none) { .ig__texto { display: none; } }
</style>
